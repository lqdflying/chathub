##### S3 Object Storage Service ########
########################################

# S3 keys
# S3_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bucket name
# S3_BUCKET=lobechat

# Bucket request endpoint
# S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com

# Public access domain for the bucket
# S3_PUBLIC_DOMAIN=https://s3-for-lobechat.your-domain.com

# Bucket region, such as us-west-1, generally not needed to add
# but some service providers may require configuration
# S3_REGION=us-west-1


########################################
############ Auth Service ##############
########################################


# Clerk related configurations

# Clerk public key and secret key
#NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxx
#CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxx

# you need to config the clerk webhook secret key if you want to use the clerk with database
#CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# Clear allow origin https://clerk.com/docs/guides/dashboard/dns-domains/satellite-domains
# Authentication across different domains , use,to splite different origin
# NEXT_PUBLIC_CLERK_AUTH_ALLOW_ORIGINS='https://market.lobehub.com,https://lobehub.com'

# NextAuth related configurations
# NEXT_PUBLIC_ENABLE_NEXT_AUTH=1
# NEXT_AUTH_SECRET=

# Auth0 configurations
# AUTH_AUTH0_ID=
# AUTH_AUTH0_SECRET=
# AUTH_AUTH0_ISSUER=https://your-domain.auth0.com

# Development-only auth bypasses (NODE_ENV=development only). Never set in production.
# 1) ENABLE_MOCK_DEV_USER=1: server-side opt-in — every request handled by the tRPC
#    lambda or WebAPI auth middleware (including /webapi/files) uses the mock identity,
#    with no header required.
# 2) AUTH_DEV_BYPASS_SECRET: requests carrying `lobe-auth-dev-backend-api: 1` plus a
#    matching `lobe-auth-dev-secret` header use the same identity for API debugging.
# Both paths resolve MOCK_DEV_USER_ID after trimming it and fall back to `DEV_USER`.
# AUTH_DEV_BYPASS_SECRET=
# ENABLE_MOCK_DEV_USER=
# MOCK_DEV_USER_ID=

########################################
########## Server Database #############
########################################

# Specify the service mode as server if you want to use the server database
# NEXT_PUBLIC_SERVICE_MODE=server

# Public app origin for browser access, OAuth callbacks, webhooks, and canonical URLs
# APP_URL=https://your-domain.com

# Optional root HTTP(S) origin for server-to-server async dispatch. Do not add
# credentials, a path, query parameters, or a fragment. Docker uses container-local
# http://127.0.0.1:${PORT:-3210} automatically when local rewrite is enabled.
# INTERNAL_APP_URL=http://127.0.0.1:3210

# Postgres database URL
# DATABASE_URL=postgres://username:password@host:port/database

# use `openssl rand -base64 32` to generate a key for the encryption of the database
# we use this key to encrypt the user api key and proxy url
#KEY_VAULTS_SECRET=xxxxx/xxxxxxxxxxxxxx=

# Specify the Embedding model and Reranker model(unImplemented)
# DEFAULT_FILES_CONFIG="embedding_model=openai/embedding-text-3-small,reranker_model=cohere/rerank-english-v3.0,query_mode=full_text"

########################################
########## MCP Service Config ##########
########################################

# MCP tool call timeout (milliseconds)
# MCP_TOOL_TIMEOUT=60000

########################################
########### Debug / Diagnostics ########
########################################

# Set Pino log level to "debug" on the server.
# Does NOT auto-enable any debug() namespaces — those must be opted into
# explicitly via the DEBUG=... variable below.
# Note: Pino redacts common top-level secret keys (apiKey, token, password,
# etc.) but does NOT catch nested fields or string-formatted secrets.
# CHATHUB_DEBUG=1

# Privacy-safe tool lifecycle diagnostics for MCP, built-in/default/markdown/
# standalone plugins, delegated provider tools, and server-agent tools.
# Use "verbose" only when bounded payload fingerprints are needed.
# CHATHUB_TOOLS_DEBUG=1
# CHATHUB_TOOLS_DEBUG=verbose

# Privacy-safe image generation diagnostics for submission, async dispatch,
# provider execution, transform/upload, and task state. Use "verbose" briefly
# when bounded prompt/config fingerprints are needed.
# CHATHUB_IMAGE_DEBUG=1
# CHATHUB_IMAGE_DEBUG=verbose

# Privacy-safe cache diagnostics. Each switch emits bounded structured JSON
# for request, usage, usage_missing, and terminal_error events. These require
# KEY_VAULTS_SECRET (or NEXT_AUTH_SECRET) for deployment-keyed fingerprints.
# DEBUG_OPENAI_CACHE=1
# DEBUG_AZURE_CACHE=1
# DEBUG_AZUREAI_CACHE=1
# DEBUG_MOONSHOT_CACHE=1
# DEBUG_DEEPSEEK_CACHE=1
# DEBUG_MINIMAX_CACHE=1
# DEBUG_ANTHROPIC_CACHE=1
# DEBUG_ANTHROPICCOMPATIBLE_CACHE=1
# DEBUG_GOOGLE_CACHE=1
# DEBUG_OPENAICOMPATIBLE_CACHE=1

# Explicitly enable specific debug() namespaces (server-side).
# Example: DEBUG=lobe-async:*,lobe-server:discover
# WARNING: many namespaces log sensitive data (prompts, auth tokens, user
# payloads, file contents). Only enable namespaces you have audited.

# Enable client-side debug logs in the browser (stores, chat routing).
# WARNING: this enables lobe-chat:* which logs instructions, agent config,
# and supervisor tool parameters — all prompt-adjacent data.
# NEXT_PUBLIC_CHATHUB_DEBUG=1

# Extra verbose: raw provider request/response stream chunks (privacy risk — avoid in production).
# DEBUG_OPENAI_CHAT_COMPLETION=1
# DEBUG_OPENAICOMPATIBLE_CHAT_COMPLETION=1
# DEBUG_OPENAICOMPATIBLE_RESPONSES=1
# DEBUG_ANTHROPIC_CHAT_COMPLETION=1
# DEBUG_ANTHROPICCOMPATIBLE_CHAT_COMPLETION=1
# DEBUG_MOONSHOT_CHAT_COMPLETION=1
# DEBUG_MINIMAX_CHAT_COMPLETION=1
# DEBUG_DEEPSEEK_CHAT_COMPLETION=1
# DEBUG_GOOGLE_CHAT_COMPLETION=1
# DEBUG_AZURE_CHAT_COMPLETION=1
# DEBUG_AZURE_AI_CHAT_COMPLETION=1
