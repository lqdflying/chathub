{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["vitest/globals", "@serwist/next/typings"],
    "paths": {
      "@/database/*": ["./packages/database/src/*", "./src/database/*"],
      "@/const/*": ["./packages/const/src/*", "./src/const/*"],
      "@/utils/*": ["./packages/utils/src/*", "./src/utils/*"],
      "@/types/*": ["./packages/types/src/*", "./src/types/*"],
      "@/*": ["./src/*"],
      "~test-utils": ["./tests/utils.tsx"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "exclude": [
    "node_modules",
    "public/sw.js",
    "apps/mobile",
    "tmp",
    "temp",
    ".temp",
    "e2e",
    "packages/obervability-otel",
    "packages/python-interpreter",
    "packages/ssrf-safe-fetch",
    "packages/web-crawler",
    "packages/utils/src/client/sanitize.ts",
    "packages/utils/tests",
    "packages/file-loaders/test",
    "packages/file-loaders/src/utils/parser-utils.ts",
    "packages/fetch-sse/src/parseError.ts"
  ],
  "include": ["**/*.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next-env.d.ts"]
}
